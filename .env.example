# MongoDB Atlas connection string (leave blank to use the local fallback below)
MONGODB_URI=

# Optional local MongoDB fallback for development machines
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/sonora

# Optional API port (defaults to 3001)
PORT=3001

# Vercel Blob read/write token (required for deployed uploads)
BLOB_READ_WRITE_TOKEN=
